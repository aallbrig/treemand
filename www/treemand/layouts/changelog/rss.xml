{{- /* The changelog feed: one item per release, linked to its heading on /changelog/. */ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>treemand changelog</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description }}</description>
    {{- with .Pages.ByDate.Reverse }}{{ with index . 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType.Type }}" />
    {{- end }}
    {{- $list := .Permalink }}
    {{- range .Pages.ByDate.Reverse }}
    {{- $id := .File.ContentBaseName | replaceRE `\.` "-" }}
    <item>
      <title>treemand {{ .Title }}</title>
      <link>{{ $list }}#{{ $id }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="false">treemand-{{ .Title }}</guid>
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
