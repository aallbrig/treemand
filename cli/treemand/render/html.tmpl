<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
<meta name="generator" content="treemand">
<title>{{.Root.Name}} command tree</title>
<style>
:root{color-scheme:light dark;--bg:#ffffff;--fg:#1f2328;--dim:#59636e;--accent:#0550ae;--pos:#8250df;--flag:#116329;--line:#d1d9e0;--mark:#fff8c5}
@media (prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--dim:#9198a1;--accent:#79c0ff;--pos:#d2a8ff;--flag:#7ee787;--line:#30363d;--mark:#3b2e00}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
header,main,footer{max-width:960px;margin:0 auto;padding:16px}
h1{margin:0 0 4px;font:600 1.6rem ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
header p{margin:0;color:var(--dim)}
.search{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
.search label{font-weight:600}
.search input{flex:1 1 240px;min-width:0;min-height:44px;padding:6px 10px;font:inherit;color:inherit;background:var(--bg);border:1px solid var(--line);border-radius:6px}
.search input:focus{outline:2px solid var(--accent);outline-offset:1px}
#status{color:var(--dim);font-size:.9em}
ul{list-style:none;margin:0;padding-left:20px;border-left:1px solid var(--line)}
ul.tree{padding-left:0;border-left:0}
li{margin:2px 0}
summary{cursor:pointer}
summary:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.leaf{padding-left:16px}
.cmd{font:600 .95em ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--accent);overflow-wrap:anywhere}
.pos{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--pos)}
.desc,.note{color:var(--dim)}
.flags{border-left:0}
.flag code{color:var(--flag);overflow-wrap:anywhere}
.flag .val{color:var(--pos)}
li.hit>details>summary .cmd,li.hit>.leaf .cmd{background:var(--mark)}
[hidden]{display:none!important}
footer{color:var(--dim);font-size:.875em}
@media (pointer:coarse){summary,.leaf{padding:8px 0}}
</style>
</head>
<body>
<header>
<h1>{{.Root.Name}}</h1>
{{with .Root.Description}}<p>{{.}}</p>{{end}}
<p>{{.Commands}} commands · {{.Flags}} flags</p>
</header>
<main>
<div class="search" role="search">
<label for="q">Search commands</label>
<input id="q" type="search" autocomplete="off" spellcheck="false" placeholder="name or description">
<span id="status" role="status" aria-live="polite"></span>
</div>
<ul class="tree" aria-label="{{.Root.Name}} commands">
{{template "node" .Root}}
</ul>
</main>
<footer>Generated by treemand. Commands marked “not discovered” were listed by their parent but their own help was not read.</footer>
<script>
(function(){
  var q=document.getElementById("q"),status=document.getElementById("status");
  var items=Array.prototype.slice.call(document.querySelectorAll("li[data-cmd]"));
  var opened=new Map();
  function remember(){items.forEach(function(li){var d=li.querySelector(":scope>details");if(d&&!opened.has(d))opened.set(d,d.open);});}
  function show(li){for(var p=li;p&&p.matches;p=p.parentElement){if(p.matches("li[data-cmd]"))p.hidden=false;if(p.tagName==="DETAILS")p.open=true;}}
  q.addEventListener("input",function(){
    var term=q.value.trim().toLowerCase();
    remember();
    if(!term){items.forEach(function(li){li.hidden=false;li.classList.remove("hit");});opened.forEach(function(o,d){d.open=o;});status.textContent="";return;}
    items.forEach(function(li){li.hidden=true;li.classList.remove("hit");});
    var n=0;
    items.forEach(function(li){if(li.getAttribute("data-text").indexOf(term)>=0){li.classList.add("hit");show(li);n++;}});
    status.textContent=n===1?"1 match":n+" matches";
  });
})();
</script>
</body>
</html>
{{define "line"}}<span class="cmd">{{.Name}}</span>{{range .Positionals}} <span class="pos">{{.}}</span>{{end}}{{with .Description}} <span class="desc">— {{.}}</span>{{end}}{{if .Stub}} <span class="note">(not discovered)</span>{{else if .Failed}} <span class="note">(help could not be read)</span>{{end}}{{end}}
{{define "node"}}<li data-cmd="{{.Command}}" data-text="{{.Command}} {{.Description}}">{{if .Expandable}}<details{{if .Open}} open{{end}}><summary>{{template "line" .}}</summary>
{{if .Flags}}<ul class="flags" aria-label="{{.Command}} flags">{{range .Flags}}<li class="flag"><code>{{.Name}}</code>{{with .Value}} <code class="val">{{.}}</code>{{end}}{{with .Description}} <span class="desc">{{.}}</span>{{end}}</li>{{end}}</ul>
{{end}}{{if .Children}}<ul>{{range .Children}}{{template "node" .}}{{end}}</ul>{{end}}</details>{{else}}<div class="leaf">{{template "line" .}}</div>{{end}}</li>
{{end}}
