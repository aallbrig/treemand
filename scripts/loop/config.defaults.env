# Loop defaults. Override any of these in .loop/config.env (gitignored).
LOOP_MAX_RELEASES_PER_DAY=0     # 0 = no cap: work until the queue is empty (the breaker is the safety net)
LOOP_MAX_CYCLES_PER_DAY=0       # 0 = no cap
LOOP_POLL_SECONDS=300            # supervisor: seconds between token-free work checks
LOOP_IDLE_EXIT_MINUTES=30        # supervisor: minutes without work before the session exits (stand down)
LOOP_TICK_SECONDS=5              # supervisor: how often it looks for the cycle-done marker
LOOP_KEY_DELAY_SECONDS=2         # supervisor: pause between keystrokes sent to the session
LOOP_SETTLE_SECONDS=30           # supervisor: wait after cycle-done for the agent's turn to end
LOOP_RELEASE_WATCH_MINUTES=90    # release.sh: how long to watch the Release workflow before calling it failed
LOOP_STALL_SECONDS=900           # supervisor: no tool use for this long in a cycle -> nudge the agent
LOOP_STALL_STEP_SECONDS=600      # supervisor: each further quiet step -> park, then /exit, then Ctrl-C
LOOP_AUTOCOMPACT_PCT=85          # auto-compaction threshold (backstop; the supervisor parks first)
LOOP_NOTIFY=1                    # supervisor: desktop notification on stalls and parks (0 = log only)
LOOP_CONTEXT_NOTE_PCT=50         # context used (%) at which the agent is told to keep the cycle lean
LOOP_CONTEXT_PARK_PCT=75         # context used (%) at which the supervisor parks the cycle
LOOP_STOP_BLOCKS=3               # Stop hook: consecutive blocks of an open cycle before it lets the turn end
LOOP_BREAKER_THRESHOLD=3         # consecutive failed cycles before the breaker trips
LOOP_REMOTE_NAME="treemand.dev dev loop"
LOOP_CLAUDE_BIN=claude
LOOP_TRUSTED_AUTHORS=aallbrig       # only issues/comments by these GitHub logins are ever acted on (comma-separated)
