# Loop defaults. Override any of these in .loop/config.env (gitignored).
LOOP_MAX_RELEASES_PER_DAY=6
LOOP_MAX_CYCLES_PER_DAY=12
LOOP_COOLDOWN_SECONDS=300        # pause between cycles when work was done
LOOP_IDLE_SLEEP_SECONDS=3600     # pause after an idle audit found nothing worth doing
LOOP_CYCLE_BUDGET_MINUTES=90     # wall-clock budget for one cycle
LOOP_BREAKER_THRESHOLD=3         # consecutive failed cycles before the breaker trips
LOOP_REMOTE_NAME="treemand dev loop"
LOOP_CLAUDE_BIN=claude
LOOP_TRUSTED_AUTHORS=aallbrig       # only issues/comments by these GitHub logins are ever acted on (comma-separated)
