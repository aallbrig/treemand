{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(task:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(govulncheck:*)",
      "Bash(dlv:*)",
      "Bash(hugo:*)",
      "Bash(tmux:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(npx --yes playwright@*)",
      "Bash(python3 -I scripts/loop/state.py:*)",
      "Bash(bash scripts/loop/*)",
      "Bash(bash scripts/*)",
      "Bash(shellcheck:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(sleep:*)",
      "Bash(date:*)",
      "Bash(tar:*)",
      "Bash(sha256sum:*)",
      "Read",
      "Edit",
      "Write",
      "Agent",
      "Skill",
      "WebFetch",
      "WebSearch",
      "PushNotification"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",
      "Bash(sudo:*)",
      "Edit(.git/**)",
      "Edit(.env*)",
      "mcp__goland"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/loop/hooks/session_start.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/loop/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/loop/hooks/post_tool.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/loop/hooks/stop_check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/loop/hooks/pre_compact.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"${CLAUDE_PROJECT_DIR:-.}\"/scripts/loop/hooks/statusline.sh"
  }
}
